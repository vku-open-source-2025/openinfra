# MongoDB root credentials (admin access; used only by the mongo container)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD_32_CHARS

# MongoDB application credentials (backend)
MONGO_USERNAME=gis_app
MONGO_PASSWORD=CHANGE_THIS_APP_PASSWORD_24_CHARS

# Backend auth (>=32 chars for JWT_SECRET_KEY)
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_32_CHARS_MIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_24_CHARS
ENVIRONMENT=production

# Optional VietMap key; empty = OpenStreetMap basemap fallback
VIETMAP_API_KEY=

# Browser origins allowed to call the API
CORS_ORIGINS=https://contribution.synapsecity.sbs
